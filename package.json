{
  "name": "scisci-wiki",
  "version": "1.0.0",
  "private": true,
  "description": "A searchable, full-text-grounded wiki of science-of-science concepts.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build_wiki.mjs && pagefind --site _site",
    "build:html": "node scripts/build_wiki.mjs",
    "check": "node scripts/validate_site.mjs",
    "serve": "python3.12 -m http.server 4173 -d _site"
  },
  "devDependencies": {
    "csv-parse": "^6.1.0",
    "marked": "^16.4.1",
    "pagefind": "^1.4.0"
  }
}
